<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>nl.hauntedmc.platform</groupId>
        <artifactId>haunted-application-parent</artifactId>
        <version>2.0.0</version>
        <relativePath/>
    </parent>
    <groupId>nl.hauntedmc.dungeons</groupId>
    <artifactId>dungeons</artifactId>
    <version>${revision}</version>
    <name>Dungeons</name>
    <description>Create, edit, and run configurable dungeon content on Paper.</description>
    <url>https://github.com/HauntedMC/Dungeons</url>
    <inceptionYear>2026</inceptionYear>
    <organization>
        <name>HauntedMC</name>
        <url>https://www.hauntedmc.nl</url>
    </organization>
    <licenses>
        <license>
            <name>GNU Affero General Public License v3.0</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>HauntedMC</id>
            <name>HauntedMC</name>
            <url>https://www.hauntedmc.nl</url>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/HauntedMC/Dungeons.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/HauntedMC/Dungeons.git</developerConnection>
        <url>https://github.com/HauntedMC/Dungeons</url>
        <tag>v1.2.7</tag>
    </scm>
    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/HauntedMC/Dungeons/issues</url>
    </issueManagement>
    <ciManagement>
        <system>GitHub Actions</system>
        <url>https://github.com/HauntedMC/Dungeons/actions</url>
    </ciManagement>
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages - Dungeons</name>
            <url>https://maven.pkg.github.com/HauntedMC/Dungeons</url>
        </repository>
    </distributionManagement>
    <properties>
        <revision>1.2.7</revision>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.build.outputTimestamp>2026-09-25T00:00:00Z</project.build.outputTimestamp>
        <reflections.version>0.10.2</reflections.version>
        <commons-io.version>2.22.0</commons-io.version>
        <commons-lang3.version>3.20.0</commons-lang3.version>
        <item-nbt-api.version>2.16.0</item-nbt-api.version>
    </properties>
    <repositories>
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>codemc-releases</id>
            <url>https://repo.codemc.io/repository/maven-releases/</url>
        </repository>
    </repositories>
    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.reflections</groupId>
            <artifactId>reflections</artifactId>
            <version>${reflections.version}</version>
        </dependency>
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>${commons-io.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>${commons-lang3.version}</version>
        </dependency>
        <dependency>
            <groupId>de.tr7zw</groupId>
            <artifactId>item-nbt-api</artifactId>
            <version>${item-nbt-api.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <finalName>Dungeons-${project.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <minimizeJar>true</minimizeJar>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <relocations>
                                <relocation>
                                    <pattern>de.tr7zw.changeme.nbtapi</pattern>
                                    <shadedPattern>nl.hauntedmc.dungeons.libs.nbtapi</shadedPattern>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>platform-acceptance</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>run-platform-acceptance</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>src/acceptance/run-acceptance.sh</argument>
                                    </arguments>
                                    <environmentVariables>
                                        <DUNGEONS_ARTIFACT>${project.build.directory}/${project.build.finalName}.jar</DUNGEONS_ARTIFACT>
                                        <DUNGEONS_PAPER_VERSION>${haunted.paper.runtime.version}</DUNGEONS_PAPER_VERSION>
                                        <DUNGEONS_PAPER_BUILD>${haunted.paper.runtime.build}</DUNGEONS_PAPER_BUILD>
                                        <DUNGEONS_PAPER_SHA256>${haunted.paper.runtime.sha256}</DUNGEONS_PAPER_SHA256>
                                    </environmentVariables>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
